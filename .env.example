# TeleRent Environment Configuration Template

PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telerent

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Telephony Configuration
# Options: 'sandbox' (Built-in simulator, instant testing), 'twilio', 'telnyx'
TELEPHONY_PROVIDER=sandbox

# Twilio Credentials (Optional)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Telnyx Credentials (Optional)
TELNYX_API_KEY=KEY01XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELNYX_CONNECTION_ID=

# Payment Gateway (Stripe) (Optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
